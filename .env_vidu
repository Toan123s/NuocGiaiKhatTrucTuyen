# TV3: Copy file này thành .env ở THƯ MỤC GỐC trước khi chạy.
# Windows: copy .env_vidu .env ; macOS/Linux: cp .env_vidu .env
# Chỉ là tài khoản mẫu local, KHÔNG phải tài khoản database thật của nhóm.
# Docker Compose tự tạo user/database dưới đây; dùng PostgreSQL có sẵn thì sửa cho đúng.
DB_HOST=localhost
DB_PORT=5432
DB_USER=brewlite
DB_PASSWORD=brewlite_local_only
DB_NAME=brewlite
API_PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
# postgres: menu lấy từ PostgreSQL. sample: chạy thử menu không cần DB (không dùng nghiệm thu).

PRODUCT_DATA_SOURCE=postgres
API_BASE_URL=http://localhost:4000



# SePay webhook - chỉ điền giá trị thật trong file .env local
SEPAY_WEBHOOK_API_KEY=e127624bbeee406c208f81770b589ad4275ed433ea2545c373a5eeac12e0857d


# Production phải đặt secret riêng, ngẫu nhiên (>= 32 ký tự), ví dụ tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET= 

# Thời hạn đăng nhập (giây), từ 60 đến 2592000. Hết hạn thì người dùng đăng nhập lại, giỏ hàng vẫn giữ.
JWT_EXPIRES_IN_SECONDS=900


# Quên mật khẩu (TV3). Liên kết trong email dẫn tới web ở địa chỉ này (mặc định: origin đầu tiên của FRONTEND_ORIGIN).
# PASSWORD_RESET_BASE_URL=http://localhost:3000
# Liên kết hết hạn sau bao nhiêu phút (5 đến 1440).

PASSWORD_RESET_EXPIRES_IN_MINUTES=5
# Gửi email thật bằng SMTP (tùy chọn, cần: npm install nodemailer -w backend). Không đặt SMTP_HOST thì liên kết chỉ được in ra console của backend khi phát triển.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=BrewLite <no-reply@example.com>

# SePay webhook - chỉ điền giá trị thật trong file .env local
SEPAY_WEBHOOK_API_KEY=replace_with_your_local_secret


# NEXT_PUBLIC_SEPAY_WEBHOOK_API_KEY=http://localhost:4000
NEXT_PUBLIC_SEPAY_WEBHOOK_API_KEY=http://localhost:4000


# URL API mà TRÌNH DUYỆT gọi (công khai, được nhúng vào bundle web lúc build). Không bao giờ đặt secret vào biến NEXT_PUBLIC_*.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
