# TV3: Copy file này thành .env ở THƯ MỤC GỐC trước khi chạy.
# Windows: copy .env_vidu .env ; macOS/Linux: cp .env_vidu .env
# Chỉ là tài khoản mẫu local, KHÔNG phải tài khoản database thật của nhóm.
# Docker Compose tự tạo user/database dưới đây; dùng PostgreSQL có sẵn thì sửa cho đúng.
DB_HOST=localhost
DB_PORT=5432
DB_USER=brewlite
DB_PASSWORD=brewlite_local_only
DB_NAME=brewlite
API_PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
# postgres: menu lấy từ PostgreSQL. sample: chạy thử menu không cần DB (không dùng nghiệm thu).
PRODUCT_DATA_SOURCE=postgres
# URL phía server Next.js; để backend nội bộ nếu triển khai qua container.
API_BASE_URL=http://localhost:4000
# TV3: JWT_SECRET dưới đây CHỈ cho máy local. Backend từ chối chạy khi NODE_ENV=production với giá trị này.
# Production phải đặt secret riêng, ngẫu nhiên (>= 32 ký tự), ví dụ tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=brewlite_local_only_jwt_secret_change_before_deploy
# Thời hạn đăng nhập (giây), từ 60 đến 2592000. Hết hạn thì người dùng đăng nhập lại, giỏ hàng vẫn giữ.
JWT_EXPIRES_IN_SECONDS=3600
# URL API mà TRÌNH DUYỆT gọi (công khai, được nhúng vào bundle web lúc build). Không bao giờ đặt secret vào biến NEXT_PUBLIC_*.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
