# TV3: Copy file này thành .env ở THƯ MỤC GỐC trước khi chạy.
# Windows: copy .env_vidu .env ; macOS/Linux: cp .env_vidu .env
# Chỉ là tài khoản mẫu local, KHÔNG phải tài khoản database thật của nhóm.
# Docker Compose tự tạo user/database dưới đây; dùng PostgreSQL có sẵn thì sửa cho đúng.
DB_HOST=localhost
DB_PORT=5432
DB_USER=brewlite
DB_PASSWORD=brewlite_local_only
DB_NAME=brewlite
API_PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
# postgres: menu lấy từ PostgreSQL. sample: chạy thử menu không cần DB (không dùng nghiệm thu).

PRODUCT_DATA_SOURCE=postgres
API_BASE_URL=http://localhost:4000

# JWT - chỉ dùng cho môi trường local
JWT_SECRET=replace_with_a_random_secret
JWT_EXPIRES_IN_SECONDS=3600

# API URL phía frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# SePay webhook - chỉ điền giá trị thật trong file .env local
SEPAY_WEBHOOK_API_KEY=replace_with_your_local_secret