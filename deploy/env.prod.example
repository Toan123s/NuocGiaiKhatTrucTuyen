# TV6 — Mẫu cấu hình production. Sao chép thành .env.prod TRÊN VPS (cùng thư mục docker-compose.prod.yml).
# KHÔNG commit file .env.prod thật. Mọi giá trị trong < > phải được thay bằng giá trị thật, ngẫu nhiên.
# Tạo secret:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
IMAGE_OWNER=<ten-chu-repo-viet-thuong>
WEB_DOMAIN=<ten-mien-web>
API_DOMAIN=<ten-mien-api>

DB_NAME=brewlite
DB_USER=brewlite
DB_PASSWORD=<mat-khau-ngau-nhien>

# >= 32 ký tự, không chứa "local_only" hay "replace_" (API từ chối khi khởi động nếu vi phạm).
JWT_SECRET=<chuoi-ngau-nhien-tu-32-ky-tu>
JWT_EXPIRES_IN_SECONDS=3600

# Đúng URL web production (https, không dùng *).
FRONTEND_ORIGIN=https://<ten-mien-web>
PASSWORD_RESET_BASE_URL=https://<ten-mien-web>

# Khóa SePay gọi webhook POST /webhooks/sepay (header "Authorization: Apikey <khóa>").
SEPAY_WEBHOOK_API_KEY=<khoa-sepay>
